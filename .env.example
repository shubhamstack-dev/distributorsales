# Copy to .env beside docker-compose.yml. Never commit .env.
MYSQL_PASSWORD=ChangeMeToALongRandomPassword123
# The same password again, URL-encoded if it has special characters (@ -> %40)
MYSQL_PASSWORD_URLENC=ChangeMeToALongRandomPassword123

# Signs the session tokens. Generate once and never change it:
#   openssl rand -hex 32
SECRET_KEY=

# The one password that opens the tool. Without it nobody can sign in.
APP_PASSWORD=

CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=60
